# Estado de sesión del detector de diseño: es local y de la máquina.
# La configuración (.impeccable/config.json) SÍ se versiona: documenta las
# excepciones sancionadas y su motivo.
.impeccable/hook.cache.json
.impeccable/config.local.json

# grafo local de graphify: nunca al repo
.graphify/

# Capacitor: node_modules y el www/ generado no se versionan.
# Los proyectos nativos (android/, ios/) SI, porque llevan la firma, los
# permisos y los iconos: sin ellos el build no es reproducible.
node_modules/
www/
